# Copy this file to ".env" in the backend/ folder and fill in real values.
# Never commit the real .env file.

# --- Server ---
PORT=5000

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcare
DB_USER=postgres
DB_PASSWORD=your_local_password

# Set to true only when connecting to a hosted/managed Postgres that requires SSL
# (Render, Railway, Supabase, AWS RDS, etc.)
DB_SSL=false

# Set to true to log every SQL query Sequelize runs (useful for debugging)
DB_LOGGING=false

# --- Auth ---
# Any long, random string. Generate one with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

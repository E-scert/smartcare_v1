# Copy this file to ".env" in the frontend/ folder.
# Create React App only exposes variables prefixed with REACT_APP_.

# Local development (backend running on your machine):
REACT_APP_API_URL=http://localhost:5000/api

# Once the backend is hosted, point this at its public URL instead, e.g.:
# REACT_APP_API_URL=https://smartcare-api.onrender.com/api
